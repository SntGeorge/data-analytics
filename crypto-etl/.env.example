# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real credentials.

# GCP project where BigQuery tables/views live.
# This is NOT a secret — project IDs are public identifiers.
# Access is controlled by IAM, not by knowing the ID.
BQ_PROJECT=dp-trosman-may26

# BigQuery dataset and table names
BQ_DATASET=crypto
BQ_TABLE=coins_daily

# BigQuery dataset location
BQ_LOCATION=US

# How many top coins to fetch (max ~250 per CoinGecko call)
COIN_LIMIT=100
